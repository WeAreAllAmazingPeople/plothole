<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <!-- The Boot parent gives us managed plugin versions, UTF-8, -parameters and the JUnit 6 BOM. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.2</version>
    <relativePath/>
  </parent>

  <groupId>be.amazingpeople.plothole</groupId>
  <artifactId>plothole-parent</artifactId>
  <version>0.1.0-SNAPSHOT</version>
  <packaging>pom</packaging>

  <name>PlotHole</name>
  <description>StoryTest framework for Spring Boot: Tests that tell a story.</description>
  <url>https://github.com/WeAreAllAmazingPeople/plothole</url>

  <modules>
    <module>plothole</module>
    <module>plothole-example</module>
  </modules>

  <properties>
    <java.version>17</java.version>
    <rest-assured.version>6.0.1</rest-assured.version>
  </properties>

  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>be.amazingpeople.plothole</groupId>
        <artifactId>plothole</artifactId>
        <version>${project.version}</version>
      </dependency>
      <dependency>
        <groupId>io.rest-assured</groupId>
        <artifactId>rest-assured</artifactId>
        <version>${rest-assured.version}</version>
      </dependency>
    </dependencies>
  </dependencyManagement>

  <distributionManagement>
    <repository>
      <id>github</id>
      <name>GitHub Packages</name>
      <url>https://maven.pkg.github.com/WeAreAllAmazingPeople/plothole</url>
    </repository>
  </distributionManagement>
</project>
